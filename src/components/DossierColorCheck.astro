  }

  .ab {
    display: grid;
    gap: 1.4rem;
  }
  .ab-row {
    display: grid;
    grid-template-columns: 9rem 1fr 5rem 9rem;
    align-items: center;
    gap: 1rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .ab-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .ab-name {
    font-weight: 550;
    font-size: 0.92rem;
  }
  .ab-bars {
    display: grid;
    gap: 0.35rem;
  }
  .bar {
    position: relative;
    height: 22px;
    background: var(--bg-soft);
    border-radius: 4px;
    overflow: hidden;
  }

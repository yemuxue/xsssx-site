---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { SITE, FEATURED_LIMIT, LATEST_NOTES_LIMIT } from '../consts';
import { byDateDesc, formatDate } from '../lib/format';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(byDateDesc);
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(byDateDesc);

const featured = works.filter((w) => w.data.featured).slice(0, FEATURED_LIMIT);
const showcase = featured.length > 0 ? featured : works.slice(0, FEATURED_LIMIT);
const latest = notes.slice(0, LATEST_NOTES_LIMIT);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">个人站 · 资料与作品集</p>
      <h1 class="display">{SITE.name}<span class="dot">.</span></h1>
      <p class="lead">{SITE.tagline}</p>

      <div class="actions">
        <a class="btn btn-primary" href="/works/">看作品 <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/notes/">读资料</a>
      </div>

      <div class="hero-meta">
        <span>{SITE.location}</span>
        <span>{SITE.focus.slice(0, 2).join(' · ')}</span>
        <span>共 {works.length} 个作品 / {notes.length} 篇资料</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title"><span class="num">01</span>精选作品</h2>
        <a class="more-link" href="/works/">全部作品 <span aria-hidden="true">→</span></a>
      </div>

      {
        showcase.length > 0 ? (
          <div class="cards">
            {showcase.map((work) => (
              <WorkCard work={work} />
            ))}
          </div>
        ) : (
          <div class="empty">还没有作品。在 <code>src/content/works/</code> 里新增一个 Markdown 文件即可。</div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title"><span class="num">02</span>最近更新</h2>
        <a class="more-link" href="/notes/">全部资料 <span aria-hidden="true">→</span></a>
      </div>

      {
        latest.length > 0 ? (
          <div class="cards">
            {latest.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        ) : (
          <div class="empty">还没有资料。在 <code>src/content/notes/</code> 里新增一个 Markdown 文件即可。</div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <h2 class="section-title" style="margin-bottom: 1rem"><span class="num">03</span>关于</h2>
          {SITE.intro.map((p) => <p>{p}</p>)}
          <p><a class="more-link" href="/about/">更多介绍 <span aria-hidden="true">→</span></a></p>
        </div>
        <aside class="panel">
          <h3>关注方向</h3>
          <div class="tag-row">
            {SITE.focus.map((f) => <span class="tag">{f}</span>)}
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

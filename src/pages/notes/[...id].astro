---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 上一篇 / 下一篇：按日期倒序排列后取相邻
const all = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const idx = all.findIndex((n) => n.id === entry.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article">
  <div class="page-head">
    <div class="container">
      <Breadcrumb items={[{ label: '资料', href: '/notes/' }, { label: entry.data.title }]} />
      <h1 class="page-title">{entry.data.title}</h1>
      {entry.data.description && <p class="page-desc">{entry.data.description}</p>}
      <div class="meta-bar">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        {
          entry.data.tags.length > 0 && (
            <>
              <span class="dot-sep">/</span>
              <span>{entry.data.tags.join(' · ')}</span>
            </>
          )
        }
      </div>
    </div>
  </div>

  <div class="article">
    <div class="container note-layout">
      <article class="prose" id="note-body">
        <Content />

        <nav class="pager" aria-label="相邻文章">
          {
            older ? (
              <a class="pager-item" href={`/notes/${older.id}/`}>
                <span class="pager-k">上一篇</span>
                <span class="pager-t">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer ? (
              <a class="pager-item next" href={`/notes/${newer.id}/`}>
                <span class="pager-k">下一篇</span>
                <span class="pager-t">{newer.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>

      {
        headings.length > 0 && (
          <aside class="note-toc" aria-label="本文目录">
            <p class="note-toc-title">本文目录</p>
            <ol>
              {headings.map((h) => (
                <li class={`toc-d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </div>

  <style>
    .note-layout {
      display: grid;
      grid-template-columns: minmax(0, 68ch) 13rem;
      gap: 3.4rem;
      justify-content: center;
      align-items: start;
    }
    .note-layout .prose {
      max-width: 68ch;
      margin-inline: 0;
    }
    .note-toc {
      position: sticky;
      top: 88px;
      font-size: 0.82rem;
    }
    .note-toc-title {
      margin: 0 0 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .note-toc ol {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .note-toc a {
      display: block;
      padding-left: 0.7rem;
      border-left: 2px solid transparent;
      color: var(--text-soft);
      text-decoration: none;
      line-height: 1.5;
    }
    .note-toc a:hover {
      color: var(--accent);
      border-left-color: var(--accent);
    }
    .pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 3.4rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--border);
    }
    .pager-item {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.9rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-elev);
      text-decoration: none;
      transition: border-color 0.15s var(--ease), background 0.15s var(--ease);
    }
    .pager-item:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
    }
    .pager-item.next {
      text-align: right;
      align-items: flex-end;
    }
    .pager-k {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--muted);
    }
    .pager-t {
      font-size: 0.9rem;
      color: var(--text);
      line-height: 1.5;
    }
    @media (max-width: 1024px) {
      .note-layout {
        grid-template-columns: 1fr;
      }
      .note-toc {
        position: static;
        order: -1;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        background: var(--bg-elev);
      }
      .note-toc ol {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
      }
      .note-toc a {
        padding-left: 0;
        border-left: 0;
      }
    }
    @media (max-width: 640px) {
      .pager {
        grid-template-columns: 1fr;
      }
      .pager-item.next {
        text-align: left;
        align-items: flex-start;
      }
    }
  </style>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索站内的资料与作品。">
  <div class="page-head">
    <div class="container">
      <p class="eyebrow">Search · 站内搜索</p>
      <h1 class="page-title">搜索</h1>
      <p class="page-desc">按标题、摘要与标签检索资料和作品。索引在构建时生成，不经过服务端。</p>
    </div>
  </div>

  <div class="article">
    <div class="container">
      <div class="search-box">
        <input
          id="q"
          type="search"
          placeholder="试试「评测」「色彩」「devops」…"
          autocomplete="off"
          aria-label="搜索关键词"
        />
        <span class="hint" id="hint">输入关键词开始</span>
      </div>
      <ol class="results search-results" id="results"></ol>
    </div>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('results');
  const hint = document.getElementById('hint');

  type Item = { type: string; title: string; desc: string; tags: string[]; url: string; date: string };
  let items: Item[] = [];

  const render = (rows: Item[], keyword: string) => {
    if (!list) return;
    list.innerHTML = rows
      .map(
        (r) => `
        <li class="hit">
          <a href="${r.url}">
            <span class="hit-kind">${r.type === 'work' ? '作品' : '资料'}</span>
            <span class="hit-title">${r.title}</span>
            <span class="hit-desc">${r.desc}</span>
            <span class="hit-meta">${r.date}${r.tags.length ? ' · ' + r.tags.slice(0, 3).join(' · ') : ''}</span>
          </a>
        </li>`,
      )
      .join('');
    if (hint) hint.textContent = keyword ? `${rows.length} 条结果` : '输入关键词开始';
  };

  fetch('/search/index.json')
    .then((r) => r.json())
    .then((data: Item[]) => {
      items = data;
      const q = new URLSearchParams(location.search).get('q') ?? '';
      if (input && q) input.value = q;
      if (q) render(search(q), q);
    });

  const search = (kw: string) => {
    const k = kw.trim().toLowerCase();
    if (!k) return [];
    return items.filter((i) =>
      [i.title, i.desc, ...i.tags].join(' ').toLowerCase().includes(k),
    );
  };

  input?.addEventListener('input', () => {
    const kw = input.value;
    render(search(kw), kw);
    const url = new URL(location.href);
    if (kw) url.searchParams.set('q', kw);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  });
</script>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .search-box input {
    flex: 1;
    padding: 0.8rem 1rem;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    outline: none;
  }
  .search-box input:focus {
    border-color: var(--accent);
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .results {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .results:empty {
    display: none;
  }
</style>

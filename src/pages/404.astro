---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个地址没有内容。" noIndex>
  <div class="container">
    <div class="notfound">
      <p class="code">404</p>
      <h1>这个地址没有内容</h1>
      <p>可能是链接过期了，或者我还没写完。</p>
      <div class="actions" style="justify-content: center">
        <a class="btn btn-primary" href="/">回首页</a>
        <a class="btn btn-ghost" href="/notes/">看资料</a>
      </div>
    </div>
  </div>
</BaseLayout>
